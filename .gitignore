# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Datos crudos (se descargan con src/cargar_datos.py, no se versionan)
data/raw/*
!data/raw/.gitkeep

# Artefactos del modelo. Se ignoran por defecto, EXCEPTO el modelo entregado:
# ese si se versiona para que el servicio arranque con el modelo real (no con
# el placeholder sintetico) sin tener que entrenar en el build.
models/*.joblib
!models/random_forest_v1.joblib

# NOTA: outputs/ SI se versiona a proposito.
# Las figuras generadas se insertan en el documento Word de la defensa.

# Sistema operativo / editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Cursor (config/cache local del editor, no del proyecto)
.cursor/
graphify-out/

# Borrador de referencia (material de estudio privado, NO va al repo publico).
# Su contenido se integra a mano en 01_desercion_estudiantil.ipynb por tandas.
notebooks/_referencia/
outputs/figuras_referencia/

# Configuracion de envio editada desde la interfaz: es estado de ejecucion,
# no codigo. Cada despliegue arranca de REPORTE_EMAIL_TO.
data/destino.json
